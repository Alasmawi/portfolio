{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/Abdulla_Alasmawi_CV.pdf",
      "destination": "https://www.dropbox.com/scl/fi/cysq8ud29lf1rxx32233i/Abdulla_Alasmawi_CV.pdf?rlkey=3lljq72npsgam3t6uzm77qpbf&st=4ducr8qq&dl=1",
      "permanent": false
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/v1",
      "destination": "/v1/index.html"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/v1/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
