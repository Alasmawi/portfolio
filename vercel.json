{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/Abdulla_Alasmawi_CV.pdf",
      "destination": "/cv",
      "permanent": false
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/cv",
      "destination": "/cv.html"
    },
    {
      "source": "/v1",
      "destination": "/v1/index.html"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/v1/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
